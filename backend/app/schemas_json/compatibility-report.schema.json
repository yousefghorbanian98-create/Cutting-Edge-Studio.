{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cutting-edge.local/schemas/compatibility-report.schema.json",
  "title": "CompatibilityReport",
  "type": "object",
  "required": ["ready", "score", "findings"],
  "properties": {
    "ready": { "type": "boolean" },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "enum": ["info", "warn", "block"] },
          "message": { "type": "string" }
        }
      }
    },
    "source": { "type": "object" }
  },
  "additionalProperties": true
}
